# =============================================================================
# ALDE – Assistente Linux de Diagnóstico e Execução
# Template de Configurações do Ambiente (.env.example)
# =============================================================================
# COMO USAR:
#   1. Copie este arquivo: cp .env.example .env
#   2. Edite o .env com suas configurações reais
#   3. O docker-compose carrega automaticamente o .env
#
# IMPORTANTE:
# - Em desenvolvimento local (venv): OLLAMA_BASE_URL=http://localhost:11434
# - No ambiente Docker Compose:     OLLAMA_BASE_URL=http://ollama:11434
# =============================================================================


# =============================================================================
# --- CONFIGURAÇÃO DO MOTOR DE IA (OLLAMA) ---
# =============================================================================

# Porta exposta pelo container do Ollama (mapeada para o host)
OLLAMA_PORT=11434

# URL base do servidor Ollama
# - Local (venv):     http://localhost:11434
# - Docker Compose:   http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434

# Modelo padrão usado pelo ALDE
# - qwen2.5-coder:1.5b  → Modelo leve, ideal para máquinas com 4GB RAM
# - alde                → Modelo customizado via Modelfile
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Modelo padrão (usado pelo backend como fallback)
DEFAULT_MODEL=alde

# Tempo que o modelo permanece carregado na memória após última requisição
# - 5m   → 5 minutos (padrão, bom equilíbrio)
# - -1   → mantém carregado indefinidamente (mais RAM, resposta instantânea)
# - 0    → descarrega imediatamente após cada resposta
OLLAMA_KEEP_ALIVE=5m

# Ativa logs detalhados do Ollama (útil para debug)
# - true  → mostra requisições, tempos de inferência
# - false → apenas erros (padrão para produção)
OLLAMA_DEBUG=false


# =============================================================================
# --- CONFIGURAÇÃO DA API FASTAPI ---
# =============================================================================

# Porta onde a API FastAPI escuta (acessível via http://localhost:8000)
PORT=8000

# Host de escuta da API
# - 0.0.0.0 → aceita conexões de qualquer interface (necessário no Docker)
# - 127.0.0.1 → apenas localhost (mais seguro, mas bloqueia acesso externo)
API_HOST=0.0.0.0

# Ambiente de execução da aplicação
# - development → habilita autoreload, logs verbosos
# - production  → otimizações de performance, logs mínimos
ENVIRONMENT=production

# Nível de detalhamento dos logs da aplicação
# - debug   → tudo (desenvolvimento)
# - info    → informações gerais (padrão)
# - warning → apenas alertas e erros
# - error   → apenas erros críticos
LOG_LEVEL=info

# Ambiente de build (usado pelo Dockerfile)
# - development → inclui ferramentas de debug
# - production  → imagem otimizada e menor
BUILD_ENV=production


# =============================================================================
# --- METADADOS DA DOCUMENTAÇÃO (SWAGGER UI) ---
# =============================================================================
# Acessível em: http://localhost:8000/api/docs (Swagger UI)
#                http://localhost:8000/api/redoc (ReDoc)

API_TITLE="ALDE - Assistente Linux de Diagnóstico e Execução"
API_VERSION="1.0.0"
API_DESCRIPTION="Assistente virtual agêntico especializado em infraestrutura Linux, Docker e diagnósticos locais. Funciona 100% offline com modelos Ollama."


# =============================================================================
# --- SEGURANÇA ---
# =============================================================================

# Chave secreta para assinatura de tokens/sessões
# ⚠️  OBRIGATÓRIO alterar em produção! Gere uma chave segura com:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=altere_esta_chave_em_producao


# =============================================================================
# --- KNOWLEDGE BASE (BASE DE CONHECIMENTO) ---
# =============================================================================

# Número máximo de comandos retornados pelo retrieval por query
# - 6    → padrão (bom equilíbrio)
# - 10   → mais contexto
# - 3    → respostas mais diretas
RETRIEVAL_TOP_N=6

# Score mínimo para um comando ser considerado relevante
# - 1 → aceita qualquer match (pode gerar ruído)
# - 2 → padrão (filtra matches fracos)
# - 3 → apenas matches fortes
RETRIEVAL_MIN_SCORE=2


# =============================================================================
# --- LIMITES E PERFORMANCE ---
# =============================================================================

# Tamanho máximo do histórico de sessão (em número de mensagens)
# - 40   → padrão (~20 trocas usuário/assistente)
# - 20   → sessões mais curtas
# - 100  → conversas longas
MAX_HISTORY_ENTRIES=40

# Tamanho máximo do histórico em caracteres
# - 80000  → padrão (~20k tokens)
# - 40000  → sessões mais curtas
MAX_HISTORY_CHARS=80000

# Limite de aviso quando input é muito grande (em caracteres)
# - 400000 → padrão (~100k tokens)
CONTEXT_WARN_CHARS=400000


# =============================================================================
# --- CORS (CROSS-ORIGIN RESOURCE SHARING) ---
# =============================================================================

# Origens permitidas (separadas por vírgula)
# - "*" → permite qualquer origem (desenvolvimento)
# - "http://localhost:3000,http://localhost:8080" → origens específicas
CORS_ORIGINS=*